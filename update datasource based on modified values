    /// <summary>
    /// </summary>
    /// <param name="sender">smmCampaignSelection data source.</param>
    /// <param name="e">Query executing event arguments.</param>
    [FormDataSourceEventHandler(formDataSourceStr(smmCampaignTable, smmCampaignSelection), FormDataSourceEventType::QueryExecuting)]
    public static void smmCampaignSelection_OnQueryExecuting(FormDataSource sender, FormDataSourceEventArgs e)
    {
        QueryBuildDataSource    campaignSelectionDS;
        QueryBuildDataSource    smmLeadTableDS;
        QueryBuildDataSource    childDS;
        FormRun                 formRun;
        str                     customerInterestValue;
        str                     projectLocationValue;
        str                     projectTypeValue;
        str                     purchaseTypeValue;
        str                     purchasingPowerValue;
        int                     childIndex;
        boolean                 hasFilter;

        formRun = sender.formRun();

        if (!formRun)
        {
            return;
        }

        customerInterestValue   = TMK_LeadClassifications_Handler::classificationValue(formRun, formControlStr(smmCampaignTable, CustomerInterest));
        projectLocationValue    = TMK_LeadClassifications_Handler::classificationValue(formRun, formControlStr(smmCampaignTable, ProjectLocation));
        projectTypeValue        = TMK_LeadClassifications_Handler::classificationValue(formRun, formControlStr(smmCampaignTable, ProjectType));
        purchaseTypeValue       = TMK_LeadClassifications_Handler::classificationValue(formRun, formControlStr(smmCampaignTable, PurchaseType));
        purchasingPowerValue    = TMK_LeadClassifications_Handler::classificationValue(formRun, formControlStr(smmCampaignTable, PurchasingPower));

        hasFilter = customerInterestValue || projectLocationValue || projectTypeValue || purchaseTypeValue || purchasingPowerValue;
        campaignSelectionDS = sender.queryBuildDataSource();

        for (childIndex = 1; childIndex <= campaignSelectionDS.childDataSourceCount(); childIndex++)
        {
            childDS = campaignSelectionDS.childDataSourceNo(childIndex);

            if (childDS.table() == tableNum(smmLeadTable))
            {
                smmLeadTableDS = childDS;
                break;
            }
        }

        if (!smmLeadTableDS && hasFilter)
        {
            smmLeadTableDS = campaignSelectionDS.addDataSource(tableNum(smmLeadTable));
            smmLeadTableDS.relations(false);
            smmLeadTableDS.joinMode(JoinMode::ExistsJoin);
            smmLeadTableDS.addLink(fieldNum(smmCampaignSelection, Party), fieldNum(smmLeadTable, Party));
        }

        if (!smmLeadTableDS)
        {
            return;
        }

        smmLeadTableDS.clearRanges();
        smmLeadTableDS.enabled(hasFilter);

        if (!hasFilter)
        {
            return;
        }

        TMK_LeadClassifications_Handler::applyLeadRange(smmLeadTableDS, fieldNum(smmLeadTable, CustomerInterest), customerInterestValue);
        TMK_LeadClassifications_Handler::applyLeadRange(smmLeadTableDS, fieldNum(smmLeadTable, ProjectLocation), projectLocationValue);
        TMK_LeadClassifications_Handler::applyLeadRange(smmLeadTableDS, fieldNum(smmLeadTable, ProjectType), projectTypeValue);
        TMK_LeadClassifications_Handler::applyLeadRange(smmLeadTableDS, fieldNum(smmLeadTable, PurchaseType), purchaseTypeValue);
        TMK_LeadClassifications_Handler::applyLeadRange(smmLeadTableDS, fieldNum(smmLeadTable, PurchasingPower), purchasingPowerValue);
    }

    private static void classificationLookup(FormControl _sender, FormControlEventArgs _e, TableId _tableId)
    {
        Query                   query = new Query();
        SysTableLookup          lookup;
        FormControlCancelableSuperEventArgs cancelableArgs;

        query.addDataSource(_tableId);
        lookup = SysTableLookup::newParameters(_tableId, _sender, true);
        lookup.parmQuery(query);

        lookup.addLookupField(fieldName2id(_tableId, fieldStr(TMK_CustomerInterest, Id)), true);
        lookup.addLookupField(fieldName2id(_tableId, fieldStr(TMK_CustomerInterest, Description)));
        lookup.performFormLookup();

        cancelableArgs = _e as FormControlCancelableSuperEventArgs;

        if (cancelableArgs)
        {
            cancelableArgs.CancelSuperCall();
        }
    }

    private static str classificationValue(FormRun _formRun, str _controlName)
    {
        FormStringControl control = _formRun.design().controlName(_controlName);

        return control.valueStr();
    }

    private static void applyLeadRange(QueryBuildDataSource _leadDS, FieldId _fieldId, str _value)
    {
        if (_value)
        {
            _leadDS.addRange(_fieldId).value(queryValue(_value));
        }
    }

